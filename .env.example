# File duy nhất chứa cấu hình local. Copy thành .env rồi điền giá trị (.env đã gitignore).

# Postgres của project Supabase (Connect → Direct → Session pooler) — cho db:push và db:test
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# API của project (Project Settings → API Keys → Secret key) — cho Edge Function chạy local
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# n8n gateway — secret ≥ 32 ký tự, giống hệt trong workflow n8n và `supabase secrets set`
N8N_WEBHOOK_BASE=https://YOUR-N8N-DOMAIN/webhook
N8N_SHARED_SECRET=

# Gemini free tier — nhiều key ngăn cách bằng dấu phẩy, key hết quota (429) tự xoay sang key kế tiếp
GEMINI_API_KEYS=key1,key2,key3,key4

# Domain widget trên Netlify (extension chỉ chạy trong iframe này)
WIDGET_ORIGIN=https://YOUR-SITE.netlify.app
