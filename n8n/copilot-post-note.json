      "parameters": {
        "jsCode": "// Secret dùng chung với Edge Function. Chưa cấu hình thì từ chối mọi request. n8n cần NODE_FUNCTION_ALLOW_BUILTIN=crypto.\nconst crypto = require('crypto');\nconst SECRET = 'REPLACE_N8N_SHARED_SECRET';\nif (SECRET.startsWith('REPLACE_') || SECRET.length < 32) throw new Error('N8N shared secret chưa được cấu hình');\nconst req = $input.first().json;\nconst got = Buffer.from(String((req.headers || {})['x-copilot-secret'] || ''));\nconst want = Buffer.from(SECRET);\nif (got.length !== want.length || !crypto.timingSafeEqual(got, want)) throw new Error('unauthorized');\nconst { website_id, session_id, content } = req.body || {};\nif (!/^[\\w-]+$/.test(website_id || '') || !/^session_[\\w-]+$/.test(session_id || '')) throw new Error('bad input');\nif (typeof content !== 'string' || !content.trim()) throw new Error('empty content');\nreturn [{ json: { website_id, session_id, content: content.slice(0, 9000) } }];"
      },
      "id": "b3a00000-0000-4000-8000-000000000002",
      "name": "Verify Secret",
      "type": "n8n-nodes-base.code",
