      "parameters": {
        "jsCode": "// Gom các trang bài viết theo workspace. Chỉ bài published còn giá trị; bài khác coi như đã gỡ.\nconst groups = new Map();\n$input.all().forEach((item, i) => {\n  const ws = $('Helpdesk · Get Workspaces').itemMatching(i).json;\n  if (!ws || !ws.website_id) return;\n  if (!groups.has(ws.website_id)) groups.set(ws.website_id, { website_id: ws.website_id, locale: ws.helpdesk_locale || 'en', list: [], meta: {} });\n  const g = groups.get(ws.website_id);\n  for (const a of (Array.isArray(item.json.data) ? item.json.data : [])) {\n    if (!a || a.status !== 'published' || !a.article_id || g.meta[a.article_id]) continue;\n    g.list.push({ article_id: a.article_id, updated_at: a.updated_at || 0 });\n    g.meta[a.article_id] = { title: a.title || '', url: a.url || '', category: (a.category && a.category.name) || null };\n  }\n});\nreturn [...groups.values()].map((json) => ({ json }));"
      },
