    {
      "parameters": {
        "jsCode": "// Secret dùng chung với Edge Function. Chưa cấu hình thì từ chối mọi request.\n// So sánh không phụ thuộc vị trí ký tự sai (n8n chặn module crypto nên không dùng timingSafeEqual).\nconst SECRET = 'REPLACE_N8N_SHARED_SECRET';\nif (SECRET.startsWith('REPLACE_') || SECRET.length < 32) throw new Error('N8N shared secret chưa được cấu hình');\nconst req = $input.first().json;\nconst got = String((req.headers || {})['x-copilot-secret'] || '');\nlet diff = got.length ^ SECRET.length;\nfor (let i = 0; i < SECRET.length; i++) diff |= SECRET.charCodeAt(i) ^ (got.charCodeAt(i) || 0);\nif (diff !== 0) throw new Error('unauthorized');\nconst { website_id, session_id } = req.body || {};\nif (!/^[\\w-]+$/.test(website_id || '') || !/^session_[\\w-]+$/.test(session_id || '')) throw new Error('bad input');\nreturn [{ json: { website_id, session_id } }];"
      },
      "id": "b2a00000-0000-4000-8000-000000000002",
      "name": "Refresh · Verify Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        450
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.crisp.chat/v1/website/{{ $json.website_id }}/conversation/{{ $json.session_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
