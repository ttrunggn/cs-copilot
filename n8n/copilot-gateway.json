        "method": "GET",
        "url": "=https://api.crisp.chat/v1/website/{{ $('Refresh · Verify Secret').first().json.website_id }}/conversation/{{ $('Refresh · Verify Secret').first().json.session_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Crisp-Tier",
              "value": "plugin"
            }
          ]
        },
        "options": {
