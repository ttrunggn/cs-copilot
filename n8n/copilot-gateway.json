    {
      "parameters": {
        "jsCode": "const out = [];\n$input.all().forEach((item, i) => {\n  const fallback = $('Sync · Get Workspaces').itemMatching(i)?.json?.website_id;\n  const convs = Array.isArray(item.json.data) ? item.json.data : [];\n  for (const c of convs) {\n    const website_id = c.website_id || fallback;\n    if (!website_id || !c.session_id) continue;\n    out.push({ json: { website_id, session_id: c.session_id, meta: c.meta || {}, state: c.state || null } });\n  }\n});\nreturn out;"
      },
      "id": "b4a00000-0000-4000-8000-000000000008",
      "name": "Sync · Split Conversations",
