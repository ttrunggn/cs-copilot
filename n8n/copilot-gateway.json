    {
      "parameters": {
        "jsCode": "// RPC trả mảng article_id; tuỳ phiên bản n8n mỗi phần tử có thể nằm ở nhiều dạng item khác nhau.\nconst out = [];\nconst seen = new Set();\n$input.all().forEach((item, i) => {\n  const g = $('Helpdesk · Build List').itemMatching(i).json;\n  const raw = item.json;\n  const values = Array.isArray(raw) ? raw : (raw && typeof raw === 'object' ? Object.values(raw).flat() : [raw]);\n  for (const v of values) {\n    if (typeof v !== 'string' || !g.meta[v] || seen.has(g.website_id + '/' + v)) continue;\n    seen.add(g.website_id + '/' + v);\n    out.push({ json: { website_id: g.website_id, locale: g.locale, article_id: v, ...g.meta[v] } });\n  }\n});\nreturn out;"
