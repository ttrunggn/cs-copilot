      },
      "id": "b2a00000-0000-4000-8000-000000000004",
      "name": "Refresh · Get Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        450
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "REPLACE_CRISP",
          "name": "Crisp Plugin Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const { website_id, session_id } = $('Refresh · Verify Secret').first().json;\nconst conv = $('Refresh · Get Conversation').first().json.data || {};\nconst meta = conv.meta || {};\nconst raw = $('Refresh · Get Messages').first().json.data;\nconst msgs = Array.isArray(raw) ? raw : [];\nconst events = [{ website_id, event: 'session:meta', data: { session_id, email: meta.email || null, nickname: meta.nickname || null, segments: meta.segments || [], state: conv.state || null } }];\nfor (const m of msgs) events.push({ website_id, event: 'message:import', data: { ...m, session_id } });\nreturn [{ json: { p_events: events } }];"
      },
      "id": "b2a00000-0000-4000-8000-000000000005",
      "name": "Refresh · Build Events",
      "type": "n8n-nodes-base.code",
