    {
      "parameters": {
        "jsCode": "// Secret dùng chung với Edge Function. Chưa cấu hình thì từ chối mọi request.\n// So sánh không phụ thuộc vị trí ký tự sai (n8n chặn module crypto nên không dùng timingSafeEqual).\nconst SECRET = 'REPLACE_N8N_SHARED_SECRET';\nif (SECRET.startsWith('REPLACE_') || SECRET.length < 32) throw new Error('N8N shared secret chưa được cấu hình');\nconst req = $input.first().json;\nconst got = String((req.headers || {})['x-copilot-secret'] || '');\nlet diff = got.length ^ SECRET.length;\nfor (let i = 0; i < SECRET.length; i++) diff |= SECRET.charCodeAt(i) ^ (got.charCodeAt(i) || 0);\nif (diff !== 0) throw new Error('unauthorized');\nconst { website_id, session_id, content } = req.body || {};\nif (!/^[\\w-]+$/.test(website_id || '') || !/^session_[\\w-]+$/.test(session_id || '')) throw new Error('bad input');\nif (typeof content !== 'string' || !content.trim()) throw new Error('empty content');\nreturn [{ json: { website_id, session_id, content: content.slice(0, 9000) } }];"
      },
