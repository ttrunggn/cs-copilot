    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crisp-ingest-REPLACE-WITH-RANDOM",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b1a00000-0000-4000-8000-000000000001",
      "name": "Ingest · Crisp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
