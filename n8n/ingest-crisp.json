{
  "name": "Copilot v5 — Ingest Crisp",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crisp-ingest-REPLACE-WITH-RANDOM",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b1a00000-0000-4000-8000-000000000001",
      "name": "Crisp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "b1a00000-0000-4000-8000-0000000000a1"
    },
    {
      "parameters": {
        "jsCode": "// Hook cấp website của Crisp không được ký (chỉ plugin hook có X-Crisp-Signature), nên webhook này được bảo vệ\n// bằng đường dẫn ngẫu nhiên. Đường dẫn còn là placeholder hoặc quá ngắn thì từ chối mọi request.\nconst path = String($('Crisp Webhook').params.path || '');\nif (path.includes('REPLACE') || path.replace('crisp-ingest-', '').length < 20) throw new Error('Đường dẫn webhook chưa được thay bằng chuỗi ngẫu nhiên');\nconst ALLOWED = ['message:send', 'message:received', 'session:set_segments', 'session:set_state', 'session:set_email', 'session:set_data'];\nconst b = $input.first().json.body;\nif (!b || typeof b !== 'object' || !ALLOWED.includes(b.event) || !b.website_id || !b.data) return [];\nreturn [{ json: { p_event: { website_id: b.website_id, event: b.event, data: b.data } } }];"
      },
      "id": "b1a00000-0000-4000-8000-000000000002",
      "name": "Filter Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-PROJECT.supabase.co/rest/v1/rpc/ingest_event",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_event: $('Filter Events').first().json.p_event }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "b1a00000-0000-4000-8000-000000000003",
      "name": "Ingest Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_SUPABASE",
          "name": "Supabase API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Chỉ tính trước sentiment cho tin khách gửi (message:received): mood đổi khi\n// khách nhắn thêm. Sự kiện khác (CS trả lời, đổi trạng thái…) thì bỏ qua.\nconst p = $('Filter Events').first().json.p_event || {};\nif (p.event !== 'message:received') return [];\nconst sessionId = p.data && p.data.session_id;\nif (!p.website_id || !sessionId) return [];\nreturn [{ json: { website_id: p.website_id, session_id: sessionId } }];"
      },
      "id": "b1a00000-0000-4000-8000-000000000004",
      "name": "Chuẩn bị precompute",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-PROJECT.supabase.co/functions/v1/copilot",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'precompute_sentiment', website_id: $json.website_id, session_id: $json.session_id }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "b1a00000-0000-4000-8000-000000000005",
      "name": "Precompute Sentiment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_SUPABASE",
          "name": "Supabase API"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Tính trước sentiment ngay sau khi ingest tin khách, để panel mở ra là có sẵn (real-time). Route nội bộ của function copilot, xác thực bằng chính credential Supabase API này (service role key) — lỗi ở node này không được làm gãy luồng ingest."
    }
  ],
