{
  "name": "Copilot v5 — Jira Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "b6a00000-0000-4000-8000-000000000001",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "b6a00000-0000-4000-8000-000000000002",
      "name": "Run Manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jira-sync-now",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b6a00000-0000-4000-8000-000000000008",
      "name": "Sync Now Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Secret dùng chung với Edge Function. Chưa cấu hình thì từ chối mọi request.\n// So sánh không phụ thuộc vị trí ký tự sai (n8n chặn module crypto nên không dùng timingSafeEqual).\nconst SECRET = 'REPLACE_N8N_SHARED_SECRET';\nif (SECRET.startsWith('REPLACE_') || SECRET.length < 32) throw new Error('N8N shared secret chưa được cấu hình');\nconst req = $input.first().json;\nconst got = String((req.headers || {})['x-copilot-secret'] || '');\nlet diff = got.length ^ SECRET.length;\nfor (let i = 0; i < SECRET.length; i++) diff |= SECRET.charCodeAt(i) ^ (got.charCodeAt(i) || 0);\nif (diff !== 0) throw new Error('unauthorized');\nconst { website_id, session_id } = req.body || {};\nif (!/^[\\w-]+$/.test(website_id || '') || !/^session_[\\w-]+$/.test(session_id || '')) throw new Error('bad input');\nreturn [{ json: {} }];"
      },
      "id": "b6a00000-0000-4000-8000-000000000009",
      "name": "Verify Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        400
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://YOUR-PROJECT.supabase.co/rest/v1/jira_links",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "issue_key"
            },
            {
              "name": "active",
              "value": "eq.true"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "b6a00000-0000-4000-8000-000000000003",
      "name": "Get Active Links",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        100
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_SUPABASE",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Ticket đang theo dõi → JQL \"key in (...)\", mỗi lô 50 key. Key sai định dạng bị bỏ để không chèn được vào JQL.\nconst KEY = /^[A-Z][A-Z0-9_]+-\\d+$/;\nconst keys = [...new Set($input.all().map((i) => i.json && i.json.issue_key).filter((k) => typeof k === 'string' && KEY.test(k)))];\nconst out = [];\nfor (let i = 0; i < keys.length; i += 50) out.push({ json: { jql: 'key in (' + keys.slice(i, i + 50).join(',') + ')' } });\nreturn out;"
      },
      "id": "b6a00000-0000-4000-8000-000000000004",
      "name": "Build JQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-JIRA.atlassian.net/rest/api/3/search/jql",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jql: $json.jql, fields: ['summary', 'status', 'assignee', 'updated', 'comment'], maxResults: 100 }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b6a00000-0000-4000-8000-000000000005",
      "name": "Search Jira",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        100
      ],
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "REPLACE_JIRA",
          "name": "Jira Copilot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Gộp kết quả các lô Jira search thành một payload cho Edge Function jira-sync.\nconst issues = [];\nfor (const item of $input.all()) for (const i of (item.json && Array.isArray(item.json.issues) ? item.json.issues : [])) issues.push(i);\nreturn [{ json: { issues } }];"
      },
      "id": "b6a00000-0000-4000-8000-000000000006",
      "name": "Collect Issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-PROJECT.supabase.co/functions/v1/jira-sync",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-copilot-secret",
              "value": "REPLACE_N8N_SHARED_SECRET"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "b6a00000-0000-4000-8000-000000000007",
      "name": "Jira Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        100
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_SUPABASE",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\": true}",
        "options": {}
      },
      "id": "b6a00000-0000-4000-8000-000000000010",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1320,
        100
      ]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Get Active Links",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Manually": {
      "main": [
        [
          {
            "node": "Get Active Links",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Active Links": {
      "main": [
        [
          {
            "node": "Build JQL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build JQL": {
      "main": [
        [
          {
            "node": "Search Jira",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search Jira": {
      "main": [
        [
          {
            "node": "Collect Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect Issues": {
      "main": [
        [
          {
            "node": "Jira Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sync Now Webhook": {
      "main": [
        [
          {
            "node": "Verify Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Secret": {
      "main": [
        [
          {
            "node": "Get Active Links",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Jira Sync": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
