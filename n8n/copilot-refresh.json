{
  "name": "Copilot v5 — Refresh Conversation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "copilot-refresh",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2a00000-0000-4000-8000-000000000001",
      "name": "Refresh Webhook",
      "type": "n8n-nodes-base.webhook",
